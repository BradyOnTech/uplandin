{
  "name": "uplandin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:2d": "vite --config vite.2d.config.ts --port 4590",
    "build": "tsc && vite build",
    "deploy": "npm run build && wrangler deploy",
    "build:2d": "tsc && vite build --config vite.2d.config.ts",
    "preview": "vite preview",
    "play:mobile": "npm run build && vite preview --host 0.0.0.0 --port 4593 --strictPort",
    "preview:2d": "vite preview --outDir dist-2d --host 0.0.0.0 --port 4591",
    "test": "vitest run",
    "dev:3d": "vite --port 4517",
    "build:3d": "tsc && vite build",
    "capture:3d": "node tools3d/capture.mjs",
    "art:menus": "node tools3d/render-menu-art.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "puppeteer": "^24.43.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  }
}
